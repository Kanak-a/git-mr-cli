# Copy to:
#   Windows:  %APPDATA%\git-mr\.env
#   Linux:    ~/.config/git-mr/.env
# Or set GITMR_ENV=/path/to/your.env

GITLAB_URL=http://your-gitlab-host
GITLAB_TOKEN=glpat-xxxxxxxx

# Project is auto-detected from `git remote` (usually origin).
# Optional overrides if detection fails or you are outside a repo:
# GITLAB_PROJECT_PATH=group/subgroup/my-repo
# GITLAB_PROJECT_ID=123
# GITLAB_GIT_REMOTE=origin

GITLAB_DEFAULT_TARGET=develop
OPENAI_API_KEY=sk-...

# Auto-generate title/description when OPENAI_API_KEY is set (default: true)
GITMR_AUTO_AI=true

# Optional: pre-set assignee so you can press Enter at review without searching
# GITMR_DEFAULT_ASSIGNEE_ID=42
